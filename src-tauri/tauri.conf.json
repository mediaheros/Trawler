{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Trawler",
  "version": "../package.json",
  "identifier": "org.mediahero.trawler",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Trawler",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 620,
        "center": true,
        "backgroundColor": "#080b11"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMzMkZBRTA5NEQ4RUVFMTMKUldRVDdvNU5DYTR2d3hNalMxbitKOUI1d1ZndytaNlRVM01LOStZR3laUjg3ZnNaSCtGZ05yQTMK",
      "endpoints": [
        "https://mediahero.org/dl/latest.json",
        "https://github.com/MediaHeroSystems/trawler/releases/latest/download/latest.json"
      ]
    }
  }
}
